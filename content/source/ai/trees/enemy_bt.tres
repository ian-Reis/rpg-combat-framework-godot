[gd_resource type="BehaviorTree" format=3 uid="uid://dg53tobkmvcff"]

[ext_resource type="Script" uid="uid://cu8ye3l004oky" path="res://content/source/ai/tasks/actions/find_target.gd" id="1_find"]
[ext_resource type="Script" uid="uid://ca7k3famoul7w" path="res://content/source/ai/tasks/conditions/is_target_in_range.gd" id="2_range"]
[ext_resource type="Script" uid="uid://bnxbxf5f6kdet" path="res://content/source/ai/tasks/actions/attack.gd" id="3_attack"]
[ext_resource type="Script" uid="uid://d5rnogkirt8e" path="res://content/source/ai/tasks/actions/move_to_target.gd" id="4_move"]

[sub_resource type="BlackboardPlan" id="BlackboardPlan_32vch"]

[sub_resource type="BTAction" id="BTAction_find"]
